{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "reviewers": ["lil-lon"],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "groupName": "mise"
    },
    {
      // codex tags releases as rust-vX.Y.Z; strip the prefix so versions compare
      "matchManagers": ["mise"],
      "matchPackageNames": ["openai/codex"],
      "extractVersion": "^rust-(?<version>v.+)$"
    }
  ]
}
